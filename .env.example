# ============================================================
# Supabase Configuration
# ============================================================

# 1. Supabase PostgreSQL Database (Used by Prisma ORM)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string
# If using Transaction Pooler (Session / Transaction mode, Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Direct mode, Port 5432) for migrations:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Supabase API (Used by Vite Frontend client SDK)
# From Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# 3. Optional Server / Auth Settings
PORT=3001
JWT_SECRET="your-jwt-secret-key"
