generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                       @id @default(uuid())
  email             String                       @unique
  name              String
  avatar            String?
  roleType          RoleType                     @default(INSTRUCTOR)
  phone             String?
  department        String?                      @default("Education")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  roleId            String?
  auditLogs         AuditLog[]
  instructorProfile Instructor?                  @relation("UserInstructor")
  notifications     Notification[]
  observedSessions  Observation[]                @relation("ObserverUser")
  templateVersions  ObservationTemplateVersion[] @relation("VersionCreator")
  managedTrack      Track?                       @relation("TrackHead")
  role              Role?                        @relation(fields: [roleId], references: [id])

  @@index([roleType])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  displayName String
  description String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Track {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique
  description  String?
  color        String        @default("#4f46e5")
  headUserId   String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  groups       Group[]
  instructors  Instructor[]
  observations Observation[]
  headUser     User?         @relation("TrackHead", fields: [headUserId], references: [id])

  @@index([name])
}

model Instructor {
  id             String           @id @default(uuid())
  userId         String           @unique
  employeeId     String           @unique // Unique Teacher Code (e.g. INS-0001)
  trackId        String
  title          String
  specialization String
  phone          String?
  employmentType String?          @default("FULL_TIME")
  hireDate       DateTime         @default(now())
  status         InstructorStatus @default(ACTIVE)
  averageScore   Float            @default(0.0)
  totalObserved  Int              @default(0)
  lastObservedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  groups         Group[]
  track          Track            @relation(fields: [trackId], references: [id])
  user           User             @relation("UserInstructor", fields: [userId], references: [id], onDelete: Cascade)
  observations   Observation[]

  @@index([trackId])
  @@index([status])
  @@index([employeeId])
}

model Group {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique // Unique Group Code (e.g. GRP-001)
  trackId      String
  instructorId String
  term         String        @default("Q4 2026")
  startDate    DateTime?
  endDate      DateTime?
  status       String        @default("ACTIVE")
  studentCount Int           @default(24)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  instructor   Instructor    @relation(fields: [instructorId], references: [id])
  track        Track         @relation(fields: [trackId], references: [id])
  observations Observation[]
  sessions     Session[]

  @@index([trackId])
  @@index([instructorId])
  @@index([code])
}

model ObservationTemplate {
  id               String                       @id @default(uuid())
  code             String                       @unique
  name             String
  type             ObservationType
  description      String
  totalScore       Float                        @default(100.0)
  isActive         Boolean                      @default(true)
  isArchived       Boolean                      @default(false)
  currentVersionId String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  versions         ObservationTemplateVersion[]

  @@index([type])
  @@index([isActive])
}

model ObservationTemplateVersion {
  id            String                      @id @default(uuid())
  templateId    String
  versionNumber String
  changeLog     String
  totalScore    Float                       @default(100.0)
  createdById   String
  isActive      Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  observations  Observation[]
  criteria      ObservationCriterion[]
  mainCriteria  ObservationMainCriterion[]
  createdBy     User                        @relation("VersionCreator", fields: [createdById], references: [id])
  template      ObservationTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([isActive])
}

model ObservationMainCriterion {
  id                String                     @id @default(uuid())
  templateVersionId String
  name              String
  description       String
  weightPercentage  Float
  calculatedScore   Float                      @default(0.0)
  orderIndex        Int                        @default(0)
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  templateVersion   ObservationTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  subCriteria       ObservationSubCriterion[]
  mainResults       ObservationMainResult[]

  @@index([templateVersionId])
  @@index([orderIndex])
}

model ObservationSubCriterion {
  id               String                   @id @default(uuid())
  mainCriterionId  String
  name             String
  description      String
  weightPercentage Float
  calculatedScore  Float                    @default(0.0)
  orderIndex       Int                      @default(0)
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  mainCriterion    ObservationMainCriterion @relation(fields: [mainCriterionId], references: [id], onDelete: Cascade)
  subResults       ObservationSubResult[]

  @@index([mainCriterionId])
  @@index([orderIndex])
}

model ObservationCriterion {
  id                String                     @id @default(uuid())
  templateVersionId String
  name              String
  description       String
  weightPercentage  Float
  orderIndex        Int                        @default(0)
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  templateVersion   ObservationTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  scores            ObservationScore[]

  @@index([templateVersionId])
  @@index([orderIndex])
}

model Observation {
  id                String                     @id @default(uuid())
  observationCode   String                     @unique
  templateVersionId String
  type              ObservationType
  instructorId      String
  observerId        String
  groupId           String
  sessionId         String?
  trackId           String
  observationDate   DateTime                   @default(now())
  status            ObservationStatus          @default(SUBMITTED)
  maxScore          Float                      @default(100.0)
  totalScore        Float                      @default(0.0)
  weightedScore     Float                      @default(0.0)
  percentageScore   Float                      @default(0.0)
  grade             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  group             Group                      @relation(fields: [groupId], references: [id])
  session           Session?                   @relation(fields: [sessionId], references: [id])
  instructor        Instructor                 @relation(fields: [instructorId], references: [id])
  observer          User                       @relation("ObserverUser", fields: [observerId], references: [id])
  templateVersion   ObservationTemplateVersion @relation(fields: [templateVersionId], references: [id])
  track             Track                      @relation(fields: [trackId], references: [id])
  feedback          ObservationFeedback?
  scores            ObservationScore[]
  mainResults       ObservationMainResult[]
  subResults        ObservationSubResult[]

  @@index([instructorId])
  @@index([observerId])
  @@index([trackId])
  @@index([groupId])
  @@index([sessionId])
  @@index([observationDate])
  @@index([status])
}

model Session {
  id              String        @id @default(uuid())
  groupId         String
  sessionNumber   Int
  sessionName     String
  sessionLink     String?
  sessionPasscode String?
  status          String        @default("NOT_OBSERVED") // NOT_OBSERVED, SCHEDULED, COMPLETED, MISSED
  scheduledDate   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  group           Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  observations    Observation[]

  @@unique([groupId, sessionNumber])
  @@index([groupId])
  @@index([status])
}

model ObservationMainResult {
  id                String                   @id @default(uuid())
  observationId     String
  mainCriterionId   String
  mainCriterionName String
  weightPercentage  Float
  maxScore          Float
  score             Float
  percentage        Float
  createdAt         DateTime                 @default(now())
  observation       Observation              @relation(fields: [observationId], references: [id], onDelete: Cascade)
  mainCriterion     ObservationMainCriterion @relation(fields: [mainCriterionId], references: [id])

  @@unique([observationId, mainCriterionId])
  @@index([observationId])
  @@index([mainCriterionId])
}

model ObservationSubResult {
  id               String                  @id @default(uuid())
  observationId    String
  mainCriterionId  String
  subCriterionId   String
  subCriterionName String
  weightPercentage Float
  maxScore         Float
  score            Float
  feedback         String?
  createdAt        DateTime                @default(now())
  observation      Observation             @relation(fields: [observationId], references: [id], onDelete: Cascade)
  subCriterion     ObservationSubCriterion @relation(fields: [subCriterionId], references: [id])

  @@unique([observationId, subCriterionId])
  @@index([observationId])
  @@index([subCriterionId])
}

model ObservationScore {
  id            String               @id @default(uuid())
  observationId String
  criterionId   String
  criterionName String
  score         Float
  weight        Float
  weightedScore Float
  feedback      String
  createdAt     DateTime             @default(now())
  criterion     ObservationCriterion @relation(fields: [criterionId], references: [id])
  observation   Observation          @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, criterionId])
  @@index([observationId])
  @@index([criterionId])
}

model ObservationFeedback {
  id                  String      @id @default(uuid())
  observationId       String      @unique
  generalComments     String
  strengths           String
  areasForImprovement String
  recommendations     String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  observation         Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("OBSERVATION_SUBMITTED")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  userRole  RoleType?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?   @default("127.0.0.1")
  userAgent String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum RoleType {
  EDUCATION_MANAGER
  HEAD_OF_TRACK
  QA_TEAM
  INSTRUCTOR
}

enum ObservationType {
  TECHNICAL
  NON_TECHNICAL
}

enum ObservationStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ARCHIVED
}

enum InstructorStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  INACTIVE
}
